[Unit]
Description=Apply verified MysticEgo Orchestra release
After=network-online.target

[Service]
Type=oneshot
CPUAccounting=yes
MemoryAccounting=yes
TasksAccounting=yes
Environment=GH_PROMPT_DISABLED=1
EnvironmentFile=-/etc/mysticego/orchestra-updater.env
StateDirectory=mysticego-orchestra-updater
StateDirectoryMode=0755
ExecStart=/usr/bin/python3 /usr/local/libexec/mysticego/orchestra-updater.py
ExecStopPost=-/usr/bin/python3 /usr/local/libexec/mysticego/record-oneshot.py mysticego-orchestra-updater.service
TimeoutStartSec=20min
UMask=0022
