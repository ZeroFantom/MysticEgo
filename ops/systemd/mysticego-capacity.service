[Unit]
Description=MysticEgo independent capacity collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mysticego-capacity
Group=mysticego-capacity
WorkingDirectory=/opt/mysticego-capacity
EnvironmentFile=/etc/mysticego/capacity.env
ExecStart=/usr/bin/dotnet /opt/mysticego-capacity/Api.Capacity.dll
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
